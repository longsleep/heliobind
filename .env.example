# Copy to .env.local, which Bun loads automatically and git ignores.
#
# PORT is picked up by the dev server with no flag needed.
#
# A host cannot be set here: .env files reach the runtime but not the shell that
# expands package.json scripts. Pass it on the command line instead, which is
# forwarded straight through:
#
#   bun run dev --host=0.0.0.0
PORT=3000

# The three protocol constants, if you have them.
#
# Left unset, the app asks for them and remembers what is typed. Set here, a
# `bun run build` bakes them into dist/ so the fields come prefilled — useful
# for a copy you install on your own phone.
#
# Both the production build and the dev server inline these; the dev server
# needs the [serve.static] env setting in bunfig.toml, which is committed.
#
# A build made this way carries the constants in its JavaScript. Do not publish
# one, and do not commit .env.local — this file is the committed one.
#BUN_PUBLIC_HELIOBIND_CIPHER_KEY=
#BUN_PUBLIC_HELIOBIND_CIPHER_IV=
#BUN_PUBLIC_HELIOBIND_BIND_KEY=
